<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Category -->
        <record id="category_dayflow_hrms" model="ir.module.category">
            <field name="name">Dayflow HRMS</field>
            <field name="description">User access levels for Dayflow HRMS</field>
            <field name="sequence">10</field>
        </record>

        <!-- Group: Employee -->
        <record id="group_dayflow_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="category_dayflow_hrms"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Normal employees with access restricted to their own records.</field>
        </record>

        <!-- Group: HR Officer -->
        <record id="group_dayflow_hr_officer" model="res.groups">
            <field name="name">HR Officer</field>
            <field name="category_id" ref="category_dayflow_hrms"/>
            <field name="implied_ids" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="comment">HR Officers with full management access across employee records, salary structures, and payslips.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Record Rules for Group: Dayflow Employee -->

        <!-- Rule: Employee can access own employee profile -->
        <record id="rule_employee_own_profile" model="ir.rule">
            <field name="name">Employee: Own Profile</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule: Employee can access own attendance -->
        <record id="rule_employee_own_attendance" model="ir.rule">
            <field name="name">Employee: Own Attendance</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule: Employee can access own leave -->
        <record id="rule_employee_own_leave" model="ir.rule">
            <field name="name">Employee: Own Leave</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Rule: Employee can read own payslip -->
        <record id="rule_employee_own_payslip" model="ir.rule">
            <field name="name">Employee: Own Payslip</field>
            <field name="model_id" ref="model_hrms_payslip"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rules for Group: Dayflow HR Officer -->
        <record id="rule_hr_officer_all_employees" model="ir.rule">
            <field name="name">HR Officer: All Employees</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_officer'))]"/>
        </record>

        <record id="rule_hr_officer_all_attendance" model="ir.rule">
            <field name="name">HR Officer: All Attendance</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_officer'))]"/>
        </record>

        <record id="rule_hr_officer_all_leave" model="ir.rule">
            <field name="name">HR Officer: All Leave</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_officer'))]"/>
        </record>

        <record id="rule_hr_officer_all_payslip" model="ir.rule">
            <field name="name">HR Officer: All Payslip</field>
            <field name="model_id" ref="model_hrms_payslip"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_officer'))]"/>
        </record>

        <record id="rule_hr_officer_all_salary_structure" model="ir.rule">
            <field name="name">HR Officer: All Salary Structure</field>
            <field name="model_id" ref="model_hrms_salary_structure"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_officer'))]"/>
        </record>
    </data>
</odoo>
